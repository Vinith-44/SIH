# go2rtc: the single camera gateway (M2).  One connection per DVR/NVR channel,
# restreamed on rtsp://127.0.0.1:8564/<camera> for the pipeline (8554 is left to MediaMTX, as in M2).
[Unit]
Description=StoreMind camera gateway (go2rtc)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=storemind
Group=storemind
ExecStart=/opt/storemind/tools/bin/go2rtc -config /etc/storemind/go2rtc.yaml
Restart=always
RestartSec=3
MemoryMax=400M
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
