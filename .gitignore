# Python environments
.venv/
venv/
env/

# Python cache
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Secrets / environment files
.env
.env.*
!.env.example

# IDE / OS files
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Build / distribution
build/
dist/
*.egg-info/

# Logs
*.log

# Temporary files
*.tmp
*.temp

# ---------------------------------------------------------------------------
# StoreMind: media, models and runtime state must never be committed.
# CLAUDE.md privacy rules and videos/README.md both require this.  Videos stay
# on the laptop; only the small ground-truth CSVs and the SOURCE.txt credit
# files travel with the repo.
# ---------------------------------------------------------------------------
videos/**
!videos/**/
!videos/**/*.md
!videos/**/*.csv
!videos/**/SOURCE.txt
!videos/**/*_truth.json
!videos/**/*_detections.json

# Model weights are large and separately licensed - fetch them, do not vendor.
models/
*.pt
*.tflite
*.onnx
*.engine
*.param
*.bin
*.hef

# Runtime state
*.db
*.db-wal
*.db-shm
storemind/data/
storemind/runs/
snapshots/
# Generated at run time by ingest/go2rtc.py; go2rtc.yaml holds camera passwords.
runtime/

# Office lock files, local binaries, secrets (added 24 Sep for the two-person setup)
~$*
tools/bin/
storemind/tools/bin/
configs/secrets.yaml
storemind/configs/secrets.yaml

# Separate venvs (e.g. the TensorFlow model-export venv, M8)
.venv-*/
