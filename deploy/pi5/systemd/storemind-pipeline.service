# StoreMind vision pipeline + dashboard (port 8000).
# Installed by scripts/install_pi5.sh; config in /etc/storemind/store.yaml.
# Type=notify + WatchdogSec: run.py sends READY after start-up and a WATCHDOG
# ping with every HEALTH event (every 10 s).  A hung loop stops the pings and
# systemd restarts the service.  (Needs the run.py systemd hook, contract PR
# "run.py --sensors + systemd notify".)
[Unit]
Description=StoreMind pipeline (cameras, analytics, dashboard)
Wants=network-online.target storemind-go2rtc.service mosquitto.service
After=network-online.target storemind-go2rtc.service mosquitto.service time-sync.target

[Service]
Type=notify
NotifyAccess=main
User=storemind
Group=storemind
WorkingDirectory=/opt/storemind/storemind
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/storemind/storemind.env
ExecStart=/opt/storemind/storemind/.venv/bin/python -m storemind.run --config /etc/storemind/store.yaml --live --api --headless --quiet
Restart=always
RestartSec=5
WatchdogSec=60
TimeoutStartSec=180
# The Pi has 4-8 GB; a leak must not take the whole box down with it.
MemoryMax=2500M
Nice=-5
# Hardening: the pipeline only needs its data folder and the network.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/storemind
StateDirectory=storemind

[Install]
WantedBy=multi-user.target
